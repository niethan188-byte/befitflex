    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "mobile_app",
            "cwd": "mobile_app",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "mobile_app (profile mode)",
            "cwd": "mobile_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "args": ["--dart-define=API_BASE=http://10.0.2.2/befitflex2/api"]
        },
        {
            "name": "mobile_app (release mode)",
            "cwd": "mobile_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": ["--dart-define=API_BASE=http://10.0.2.2/befitflex2/api"]
        },
        {
            "name": ".widget_preview",
            "cwd": "mobile_app\\.widget_preview",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": ".widget_preview (profile mode)",
            "cwd": "mobile_app\\.widget_preview",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": ".widget_preview (release mode)",
            "cwd": "mobile_app\\.widget_preview",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}